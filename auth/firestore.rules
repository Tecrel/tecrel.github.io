rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTecrel() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'github.com'
        && '249088501' in request.auth.token.firebase.identities['github.com'];
    }

    match /private/author-workspace {
      allow get: if isTecrel();
    }

    match /publish-queue/{job} {
      allow get: if isTecrel() && resource.data.ownerUid == request.auth.uid;
      allow create: if isTecrel()
        && job.matches('^[a-f0-9]{64}$')
        && request.resource.data.keys().hasOnly(['ownerUid', 'filename', 'markdown', 'baseSha', 'status', 'submittedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.submittedAt == request.time
        && request.resource.data.filename.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*[.]md$')
        && request.resource.data.filename.size() <= 94
        && request.resource.data.markdown is string
        && request.resource.data.markdown.size() > 0
        && request.resource.data.markdown.size() <= 200000
        && request.resource.data.baseSha.matches('^([a-f0-9]{40})?$');
    }
  }
}
